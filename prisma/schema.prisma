  name        String
  description String?
  isActive    Boolean  @default(true)
  triggerType String   // 'MISSED_CALL', 'NEGATIVE_SENTIMENT', 'TICKET_CLOSED'
  actionType  String   // 'SEND_WHATSAPP', 'CREATE_TICKET', 'ESCALATE'
  actionConfig Json?   // Stores template, payload, etc.
  
  triggers    AutomationTrigger[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AutomationTrigger {
  id             String             @id @default(uuid()) 
  workflowId     String             
  workflow       WorkflowAutomation @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  targetId       String?            // The ID of the item that triggered this (e.g., callSid, ticketId)
  status         String             // 'PENDING', 'SUCCESS', 'FAILED'
  executionLog   String?
  
  executedAt     DateTime?
  createdAt      DateTime @default(now())
}

model CallSession {
  id             String        @id @default(uuid()) 
  conversationId String?       
  callerUserId   String?       
  calleeUserId   String?       
  customerId     String?       
  status         CallStatus    @default(RINGING)
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?          @default(0)
  recordingUrl   String?
  reason         String?
  livekitRoom    String?
  livekitSipParticipantIdentity String?
  livekitEgressId String?
  transferHistory Json?
  holdDuration   Int?          @default(0)
  aiProcessingStatus String    @default("PENDING") // PENDING, RECORDING_PENDING, TRANSCRIBING, ANALYZING, COMPLETED, FAILED
  recordingStatus       String?  @default("NOT_AVAILABLE") // PENDING, RECORDING, PROCESSING, READY, FAILED, NOT_AVAILABLE
  recordingStoragePath  String?
  recordingMimeType     String?
  recordingFileSize     Int?
  recordingDuration     Int?
  recordingStartedAt    DateTime?
  recordingCompletedAt  DateTime?
  createdAt      DateTime      @default(now())

  caller         User?         @relation("CallsMade", fields: [callerUserId], references: [id])
  callee         User?         @relation("CallsReceived", fields: [calleeUserId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  mediasoupTransports MediasoupTransport[]

  participants   CallParticipant[]
  recordings     CallRecording[]
  analytics      CallAnalytics?
  appointments   Appointment[]
  aiUsageRecords AiUsageRecord[]
  sopExecutions  SopExecution[]
  leadId         String?       
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  liveNotes      Json?
  intakeForm     Json?
  transferAudits CallTransferAudit[]
  activities     LeadActivity[]

  // Phase 25: Inbound Call Source Attribution & Cross-Unit Intelligence
  providerCallId       String?
  callerNumber         String?
  originalCallerId     String?
  calledNumber         String?
  direction            String?       @default("INBOUND")
  provider             String?       @default("vobiz")
  source               String?
  sourceType           String?       @default("UNKNOWN") // VERIFIED, INFERRED, UNKNOWN
  campaign             String?
  trackingNumber       String?
  referralSource       String?
  sourceMetadata       Json?
  callerMatchStatus    String?       // MATCH_FOUND, NO_HISTORY, MULTIPLE_MATCHES, LOOKUP_FAILED
  unitId               String?       
  unit                 Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  departmentId         String?       
  department           Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  queueId              String?       
  queue                Queue?        @relation(fields: [queueId], references: [id], onDelete: SetNull)
  draftNotes           Json?
  disposition          String?
  enquiryCategory      EnquiryCategory?
  whatsappStatus       String?       @default("UNKNOWN")

  @@index([status])
  @@index([startedAt])
  @@index([callerUserId])
  @@index([customerId])
  @@index([providerCallId])
  @@index([callerNumber])
  @@index([calledNumber])
  @@index([unitId])
  @@index([departmentId])
  @@index([queueId])
  // Canonical Tenant linkage
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)

}

model CallParticipant {
