model StaffRequirement {
  id                    String    @id @default(uuid()) 
  requirementCode       String    @unique
  category              String
  qualificationRequired String?
  location              String?
  unitId                String?   
  openPositions         Int       @default(1)
  fulfilledPositions    Int       @default(0)
  urgency               String    @default("NORMAL") // 'CRITICAL', 'HIGH', 'NORMAL'
  requiredByDate        DateTime
  status                String    @default("OPEN") // 'OPEN', 'PARTIALLY_FULFILLED', 'FULFILLED', 'CANCELLED'
  notes                 String?
  createdById           String?   
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([category])
  @@index([status])
  @@index([urgency])
  @@index([requiredByDate])
}

model SopDailyReport {
  id            String        @id @default(uuid()) 
  department    SopDepartment
  reportDate    DateTime      @db.Date
  reporterId    String        
  reporterName  String
  unitId        String?       
  metrics       Json
  status        String        @default("SUBMITTED") // 'DRAFT', 'SUBMITTED', 'APPROVED'
  approvedById  String?       
  approvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([department, reportDate, reporterId])
  @@index([department])
  @@index([reportDate])
}

model SalesPipelineStage {
  id                  String    @id @default(uuid()) 
  leadId              String    
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage               String
  previousStage       String?
  actorId             String    
  actorName           String
  notes               String?
  tariffAmount        Decimal?  @db.Decimal(12, 2)
  officeServiceCharge Decimal?  @db.Decimal(12, 2)
  paymentStatus       String?
  matchedStaffId      String?
  alternateStaffId    String?
  nextActionDate      DateTime?
  metadata            Json?
  createdAt           DateTime  @default(now())

  @@index([leadId])
  @@index([stage])
  @@index([actorId])
  @@index([nextActionDate])
}

