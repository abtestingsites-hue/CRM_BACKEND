  name                  String
  phone                 String
  email                 String?
  gender                String?
  category              String    // 'CAREGIVER', 'NURSE', 'ICU_NURSE', 'PHYSIOTHERAPIST', 'DEMENTIA_CARE', 'BEDRIDDEN_CARE'
  classification        String    @default("NORMAL") // 'GOOD', 'NORMAL', 'BAD', 'REJECTED'
  verificationStatus    String    @default("PENDING") // 'PENDING', 'DOCUMENTS_VERIFIED', 'SECOND_HR_CONFIRMED', 'VERIFIED', 'REJECTED'
  qualifications        String?
  experienceYears       Float?
  city                  String?
  location              String?
  preferredShift        String?   // 'DAY', 'NIGHT', '24_HOURS', 'ANY'
  dailyRate             Decimal?  @db.Decimal(10, 2)
  monthlySalary         Decimal?  @db.Decimal(10, 2)
  source                String?   // 'REFERRAL', 'AGENCY', 'WALK_IN', 'ONLINE'
  emergencyContact      String?
  idProofType           String?
  idProofNumber         String?
  policeVerificationDone Boolean  @default(false)
  medicalFitnessDone    Boolean   @default(false)
  documents             Json?
  isAvailable           Boolean   @default(true)
  currentAssignmentId   String?
  alternateAssignmentId String?
  secondHrVerifiedBy    String?
  secondHrVerifiedAt    DateTime?
  tlmHandoverAt         DateTime?
  joiningDate           DateTime?
