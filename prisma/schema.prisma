  activeCalls     Int         @default(0)
  lastAssignedAt  DateTime?
  extension       String?     @unique
  skills          String[]    @default([])

  // Relationships
  assignedCalls   CallLog[]
  assignedTickets Ticket[]
  conversations   Conversation[]
  sessions        WebsocketSession[]
  calendar        Calendar?
  crmTasks        CrmTask[]
  appointmentsAsDoctor Appointment[] @relation("DoctorAppointments")
  appointmentsAsAgent  Appointment[] @relation("AgentAppointments")

  // CRM Expansion Relations
  departments     Department[]
  queueAssignments QueueAssignment[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Lead Management Relations
  assignedLeads       Lead[] @relation("AssignedLeads")
  agentFollowups      LeadFollowup[] @relation("AgentFollowups")
  agentConversionLogs LeadConversionLog[] @relation("AgentConversionLogs")
  sopAssignedExecutions SopExecution[] @relation("SopAssignedAgent")
  initiatedTransfers  CallTransferAudit[] @relation("InitiatedTransfers")
  receivedTransfers   CallTransferAudit[] @relation("ReceivedTransfers")
  leadTransferAssignments LeadTransferAudit[] @relation("LeadTransferAssignedAgent")
  leadActivities      LeadActivity[]
  // Canonical Tenant linkage
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)

}

