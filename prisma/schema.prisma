model LeadUploadHistory {
  id              String   @id @default(uuid()) 
  fileName        String
  uploadedById    String   
  uploadedBy      User     @relation("LeadUploads", fields: [uploadedById], references: [id])
  
  totalRows       Int      @default(0)
  successfulRows  Int      @default(0)
  failedRows      Int      @default(0)
  status          String   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  errorLog        Json?
  
  leads           Lead[]
  
  createdAt       DateTime @default(now())
}

model LeadNotification {
  id          String   @id @default(uuid()) 
  leadId      String   
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  type        String   // REMINDER, ASSIGNMENT, STATUS_CHANGE
  channel     String   // WHATSAPP, SMS, EMAIL, IN_APP
  content     String
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  scheduledFor DateTime?
  
  createdAt   DateTime @default(now())
  sentAt      DateTime?
}

model WebsiteLeadSubmission {
  id                    String      @id @default(uuid()) 
  sourceId              String
  externalSubmissionId  String
  leadId                String      
  lead                  Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sourceSubmittedAt     DateTime?
  payloadHash           String?
  status                String      @default("PROCESSED")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([sourceId, externalSubmissionId])
  @@index([sourceId])
  @@index([externalSubmissionId])
  @@index([leadId])
}

model UnitMembership {
  id          String       @id @default(uuid()) 
  unitId      String       
  unit        Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId      String       
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInUnit  String       @default("MEMBER") // ADMIN, SUPERVISOR, MEMBER
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([unitId, userId])
  @@index([unitId])
  @@index([userId])
  // Canonical Tenant linkage
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)

}

model IntegrationConfiguration {
  id              String        @id @default(uuid()) 
  provider        String        // LIVEKIT, VOBIZ, WHATSAPP, INSTAGRAM, EMAIL, GEMINI, SUPABASE, TWILIO
  unitId          String?       
  unit            Unit? @relation(fields: [unitId], references: [id], onDelete: Cascade)
  enabled         Boolean       @default(true)
  settings        Json?         // Public/non-secret parameters
  secretEncrypted String?       // Protected/encrypted or system-managed reference
  secretLast4     String?       // Safe masked identifier e.g. "••••3b8b"
  status          String        @default("NOT_CONFIGURED") // CONFIGURED, NOT_CONFIGURED, HEALTHY, FAILED
  lastTestedAt    DateTime?
  lastTestStatus  String?
  lastTestError   String?
  version         Int           @default(1)
  updatedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([provider])
  @@index([unitId])
  // Canonical Tenant linkage
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)

}

model AdminAuditLog {
  id          String   @id @default(uuid()) 
  actorId     String?
  actorEmail  String
  action      String
  resource    String
  resourceId  String?
  outcome     String   @default("SUCCESS") // SUCCESS, FAILED, DENIED
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorEmail])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model LeadTransferAudit {
  id              String        @id @default(uuid()) 
  leadId          String        
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sourceUnitId    String?       
  sourceUnit      Unit? @relation("TransferSourceUnit", fields: [sourceUnitId], references: [id], onDelete: SetNull)
  destUnitId      String        
  destUnit        Unit  @relation("TransferDestUnit", fields: [destUnitId], references: [id], onDelete: Cascade)
  assignedAgentId String?       
  assignedAgent   Agent?        @relation("LeadTransferAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  transferredById String?       
  transferredBy   User?         @relation(fields: [transferredById], references: [id], onDelete: SetNull)
  status          String        @default("COMPLETED") // COMPLETED, PENDING, REJECTED
  sourceDepartment String?
  destDepartment  String?
  reason          String?
  preserveHistory Boolean       @default(true)
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([leadId])
  @@index([sourceUnitId])
  @@index([destUnitId])
  @@index([transferredById])
  @@index([assignedAgentId])
  @@index([createdAt])
}

model LeadActivity {
  id                String        @id @default(uuid()) 
  leadId            String        
  lead              Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  callSessionId     String?       
  callSession       CallSession?  @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  conversationId    String?       
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  agentId           String?       
  agent             Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  type              String        // 'COMMUNICATION', 'NOTE', 'CALL', 'TRANSFER', 'STATUS_CHANGE', 'FOLLOWUP'
  channel           String?       // 'WHATSAPP', 'INSTAGRAM', 'EMAIL', 'VOICE', 'SYSTEM'
  direction         String?       // 'INBOUND', 'OUTBOUND'
  title             String
  content           String?
  providerMessageId String?
  status            String?       // 'SENT', 'DELIVERED', 'READ', 'FAILED', 'PENDING'
  metadata          Json?
  createdAt         DateTime      @default(now())

  @@index([leadId])
  @@index([callSessionId])
  @@index([conversationId])
  @@index([agentId])
  @@index([type])
  @@index([createdAt])
}

model AiUsageRecord {
  id              String        @id @default(uuid()) 
  callSessionId   String?       
  callSession     CallSession?  @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  unitId          String?       
  unit            Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  provider        String        @default("gemini")
  model           String
  feature         String        // 'call_summary', 'transcription', 'sentiment'
  promptTokens    Int           @default(0)
  candidateTokens Int           @default(0)
  totalTokens     Int           @default(0)
  audioSeconds    Int?          @default(0)
  estimatedCost   Float         @default(0)
  measuredCost    Float?
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([callSessionId])
  @@index([unitId])
  @@index([feature])
  @@index([model])
  @@index([createdAt])
}

model SopTemplate {
  id               String            @id @default(uuid()) 
  code             String            @unique
  title            String
  description      String?
  department       SopDepartment
  category         String
  priority         SopPriority       @default(NORMAL)
  recurrence       SopRecurrence     @default(NONE)
  unitId           String?           
  unit             Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  requiresApproval Boolean           @default(false)
  escalationHours  Int?              @default(24)
  isActive         Boolean           @default(true)
  isArchived       Boolean           @default(false)
  createdById      String?           
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  versions         SopTemplateVersion[]
  executions       SopExecution[]

  @@index([department])
  @@index([category])
  @@index([unitId])
  @@index([isActive])
  // Canonical Tenant linkage
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)

}

model SopTemplateVersion {
  id               String            @id @default(uuid()) 
  templateId       String            
  template         SopTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  versionNumber    Int               @default(1)
  status           SopTemplateStatus @default(DRAFT)
  changelog        String?
  effectiveDate    DateTime?
  reviewDate       DateTime?
  publishedById    String?           
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  steps            SopStep[]
  executions       SopExecution[]
  acknowledgements SopAcknowledgement[]

  @@unique([templateId, versionNumber])
  @@index([templateId])
  @@index([status])
}

model SopStep {
  id                 String             @id @default(uuid()) 
  versionId          String             
  version            SopTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  stepOrder          Int
  title              String
  description        String?
  isMandatory        Boolean            @default(true)
  requiresAttachment Boolean            @default(false)
  requiresNotes      Boolean            @default(false)
  estimatedMinutes   Int?
  roleRequired       String?
  validationRules    Json?
  createdAt          DateTime           @default(now())

  checklistResponses SopChecklistResponse[]

  @@index([versionId, stepOrder])
}

model SopExecution {
  id                 String             @id @default(uuid()) 
  templateId         String             
  template           SopTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateVersionId  String             
  templateVersion    SopTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  taskNumber         String             @unique
  title              String
  department         SopDepartment
  category           String
  priority           SopPriority        @default(NORMAL)
  status             SopExecutionStatus @default(ASSIGNED)
  unitId             String?            
  unit               Unit?      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  assignedAgentId    String?            
  assignedAgent      Agent?             @relation("SopAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedRole       String?
  dueDate            DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  blockedReason      String?
  notes              String?
  completionEvidence Json?
  createdById        String?            
  createdByUser      User?              @relation("SopCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById       String?            
  approvedByUser     User?              @relation("SopApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  approvalNotes      String?

  // Linked CRM Context
  customerId         String?            
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId             String?            
  lead               Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ticketId           String?            
  ticket             Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  callSessionId      String?            
  callSession        CallSession?       @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  metadata           Json?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  checklistResponses SopChecklistResponse[]
  approvals          SopApproval[]
  workflowEvents     SopWorkflowEvent[]

  @@index([department])
  @@index([status])
  @@index([assignedAgentId])
  @@index([unitId])
  @@index([dueDate])
  @@index([createdAt])
  // Canonical Tenant linkage
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)

}

model SopChecklistResponse {
  id                 String             @id @default(uuid()) 
  executionId        String             
  execution          SopExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepId             String             
  step               SopStep            @relation(fields: [stepId], references: [id], onDelete: Cascade)
  isCompleted        Boolean            @default(false)
  notes              String?
  attachmentUrl      String?
  completedById      String?            
  completedAt        DateTime?

  @@unique([executionId, stepId])
  @@index([executionId])
}

model SopApproval {
  id                 String             @id @default(uuid()) 
  executionId        String             
  execution          SopExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  approverId         String             
  approver           User               @relation(fields: [approverId], references: [id], onDelete: Cascade)
  status             SopApprovalStatus  @default(PENDING)
  comments           String?
  reviewedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@index([executionId])
  @@index([approverId])
  @@index([status])
}

model SopAcknowledgement {
  id                 String              @id @default(uuid()) 
  templateVersionId  String?             
  templateVersion    SopTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  documentId         String?             
  document           SopDocument?        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId             String              
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId             String?             
  acknowledgedAt     DateTime            @default(now())
  ipAddress          String?
  userAgent          String?

  @@index([templateVersionId])
  @@index([documentId])
  @@index([userId])
}

model SopDocument {
  id                      String            @id @default(uuid()) 
  documentNumber          String            @unique
  title                   String
  description             String?
  department              SopDepartment
  category                String
  version                 String            @default("1.0")
  fileUrl                 String?
  fileName                String?
  fileSize                Int?
  mimeType                String?
  content                 String?           @db.Text
  effectiveDate           DateTime?
  reviewDate              DateTime?
  requiresAcknowledgement Boolean           @default(true)
  status                  String            @default("ACTIVE")
  unitId                  String?           
  unit                    Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdById             String?           
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  acknowledgements        SopAcknowledgement[]

  @@index([department])
  @@index([category])
  @@index([unitId])
  // Canonical Tenant linkage
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)

}

model SopWorkflowEvent {
  id                 String             @id @default(uuid()) 
  executionId        String?            
  execution          SopExecution?      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  eventType          String
  fromDepartment     String?
  toDepartment       String?
  actorId            String?
  actorEmail         String?
  action             String
  details            Json?
  createdAt          DateTime           @default(now())

  @@index([executionId])
  @@index([eventType])
  @@index([createdAt])
}

model ServiceCatalogItem {
  id              String   @id @default(uuid()) 
  foundationKey   String   // 'UEC', 'UHC', 'AMBULANCE', 'A_CARE', 'THATHA_PATTI', 'ZENCURA', etc.
  foundationName  String
  category        String   // Category or section
  name            String   // Service name
  code            String?  // Canonical code
  description     String?
  subServices     String[] @default([])
  intakeFields    Json?    // Optional custom fields config
  isEmergency     Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([foundationKey])
  @@index([isActive])
}

model EmergencyOverrideAudit {
  id              String   @id @default(uuid()) 
  leadId          String?  
  conversationId  String?  
  previousPriority Priority
  newPriority     Priority
  overrideReason  String
  overriddenById  String   
  overriddenByRole String?
  createdAt       DateTime @default(now())

  @@index([leadId])
  @@index([conversationId])
  @@index([createdAt])
}

model CallTransferAudit {
  id                  String             @id @default(uuid()) 
  callSessionId       String             
  callSession         CallSession        @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  initiatingAgentId   String             
  initiatingAgent     Agent              @relation("InitiatedTransfers", fields: [initiatingAgentId], references: [id])
  destinationAgentId  String?            
  destinationAgent    Agent?             @relation("ReceivedTransfers", fields: [destinationAgentId], references: [id])
  sourceDepartment    String?
  destDepartment      String?
  transferMode        CallTransferMode   @default(BLIND)
  status              CallTransferStatus @default(INITIATED)
  reason              String?
  failureReason       String?
  initiatedAt         DateTime           @default(now())
  completedAt         DateTime?
  metadata            Json?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([callSessionId])
  @@index([initiatingAgentId])
  @@index([destinationAgentId])
  @@index([status])
  @@index([createdAt])
}

model LeadDuplicateReview {
  id                String                @id @default(uuid()) 
  primaryLeadId     String                
  primaryLead       Lead                  @relation("PrimaryLeadReviews", fields: [primaryLeadId], references: [id], onDelete: Cascade)
  duplicateLeadId   String                
  duplicateLead     Lead                  @relation("DuplicateLeadReviews", fields: [duplicateLeadId], references: [id], onDelete: Cascade)
  matchingFields    String[]              // e.g. ["phoneNumber", "email", "customerName"]
  confidenceScore   Int                   // 0-100
  status            DuplicateMatchOutcome @default(POSSIBLE_DUPLICATE)
  reviewedById      String?               
  reviewedBy        User?                 @relation("DuplicateReviews", fields: [reviewedById], references: [id])
  resolutionNotes   String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([primaryLeadId])
  @@index([duplicateLeadId])
  @@index([status])
  @@index([createdAt])
}

model LeadMergeAudit {
  id                    String      @id @default(uuid()) 
  primaryLeadId         String      
  primaryLead           Lead        @relation("PrimaryLeadMerges", fields: [primaryLeadId], references: [id], onDelete: Cascade)
  mergedLeadId          String      
  mergedLeadSnapshot    Json        // Complete snapshot of merged lead prior to merge for recovery
  conflictResolutions   Json?       // Details on how conflicting fields were resolved
  mergedById            String      
  mergedBy              User        @relation("LeadMerges", fields: [mergedById], references: [id])
  reason                String?
  createdAt             DateTime    @default(now())

  @@index([primaryLeadId])
  @@index([mergedLeadId])
  @@index([createdAt])
}

model StaffProfile {
