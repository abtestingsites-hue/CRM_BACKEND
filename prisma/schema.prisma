model Appointment {
  id                 String             @id @default(uuid()) 
  bookingId          String             @unique @default(uuid())
  calendarId         String?            
  calendar           Calendar?          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  
  customerId         String?            
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  leadId             String?            
  lead               Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  
  doctorId           String?            
  doctor             Agent?             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  
  assignedAgentId    String?            
  assignedAgent      Agent?             @relation("AgentAppointments", fields: [assignedAgentId], references: [id])

  title              String
  treatment          String?
  date               DateTime           @db.Date
  startTime          DateTime
  endTime            DateTime
  duration           Int                @default(30) // in minutes
  timezone           String             @default("UTC")
  
  status             AppointmentStatus  @default(REQUESTED)
  bookingSource      BookingSource      @default(CRM)
  appointmentType    String?
  notes              String?
  
  cancellationReason String?
  rescheduleReason   String?
  confirmationStatus String?
  reminderStatus     String?
  
  createdBy          String?            
  updatedBy          String?            
  
  callSessionId      String?            
  callSession        CallSession?       @relation(fields: [callSessionId], references: [id])
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([doctorId, startTime])
  @@index([customerId])
  @@index([startTime])
  @@index([status])
}

model CrmTask {
