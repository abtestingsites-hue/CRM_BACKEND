model Lead {
  id                String      @id @default(uuid()) 
  customerName      String
  phoneNumber       String      @unique
  email             String?
  serviceInterest   String?     // 'Elderly Care', 'Home Service', etc.
  city              String?
  notes             String?
  source            String?     // e.g. 'Excel Upload', 'Website'
  status            LeadStatus  @default(NEW)
  priority          LeadPriority @default(NORMAL)
  conversionScore   Int?        // 0-100 from Gemini
  sentiment         String?     // 'POSITIVE', 'NEGATIVE', 'NEUTRAL'
  
  uploadedById      String?     
  uploadedBy        User?       @relation("UploadedLeads", fields: [uploadedById], references: [id])
  
  assignedAgentId   String?     
  assignedAgent     Agent?      @relation("AssignedLeads", fields: [assignedAgentId], references: [id])
  
  uploadHistoryId   String?     
  uploadHistory     LeadUploadHistory? @relation(fields: [uploadHistoryId], references: [id])

  lockedAt          DateTime?   // For Redis/DB lock when claiming
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  unitId            String?     
  unit              Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  followups         LeadFollowup[]
  conversionLogs    LeadConversionLog[]
  notifications     LeadNotification[]
  appointments      Appointment[]
  submissions       WebsiteLeadSubmission[]
  transferAudits    LeadTransferAudit[]
  sopExecutions     SopExecution[]
  callSessions      CallSession[]
  conversationsLinked Conversation[] @relation("ConversationLead")
  activities        LeadActivity[]
  salesPipelineStages SalesPipelineStage[]

  // Omnichannel Enquiry Intelligence & Call Intake
  foundation                  String?
  enquiryCategory             EnquiryCategory?
  primaryService              String?
  subServices                 String[]           @default([])
  patientName                 String?
  patientAge                  Int?
  patientWeight               Float?
  patientWeightUnit           String?            @default("kg")
  patientConditions           String?
  patientMobility             String?
  engagementType              String?
  careDurationCategory        String?
  careDuration                String?
  careSchedule                String?
  serviceAddress              String?
  cityDistrict                String?
  postalCode                  String?
  secondaryPhone              String?
  secondaryCountryCode        String?
  street                      String?
  state                       String?
  country                     String?
  whatsappStatus              String?            @default("UNKNOWN")
  whatsappVerifiedAt          DateTime?
  latitude                    Float?
  longitude                   Float?
  pickupLocation              String?
  destinationLocation         String?
  isAmbulanceEmergency        Boolean            @default(false)
  emergencyOverrideReason     String?
  classificationConfidence    Float?
  isClassificationConfirmed   Boolean            @default(false)
  omnichannelConversationId   String?            
  omnichannelConversation     Conversation?      @relation("OmnichannelOrigin", fields: [omnichannelConversationId], references: [id], onDelete: SetNull)
  liveNotes                   Json?

  // Agent Feedback & Customer Disposition (Phase 27)
  interestLevel               String?
  customerDisposition         String?
  agentFeedback               String?
  nextAction                  String?
  followupDate                DateTime?
  followupTime                String?
  followupType                String?
  followupNotes               String?
  feedbackAgentId             String?            
  feedbackAgentName           String?
  feedbackSubmittedAt         DateTime?

  // Deduplication & Safe Merge
  isMerged                    Boolean            @default(false)
  mergedIntoLeadId            String?            
  mergedIntoLead              Lead?              @relation("MergedLeads", fields: [mergedIntoLeadId], references: [id], onDelete: SetNull)
  mergedFromLeads             Lead[]             @relation("MergedLeads")
  duplicateReviewsAsPrimary   LeadDuplicateReview[] @relation("PrimaryLeadReviews")
  duplicateReviewsAsDuplicate LeadDuplicateReview[] @relation("DuplicateLeadReviews")
  mergesAsPrimary             LeadMergeAudit[]   @relation("PrimaryLeadMerges")

  @@index([status])
  @@index([assignedAgentId])
  @@index([unitId])
  @@index([createdAt])
  @@index([foundation])
  @@index([isAmbulanceEmergency])
  @@index([isMerged])
  // Canonical ERP linkages
  tenantId              String?
  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  clientId              String?
  client                Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  canonicalEnquiry      Enquiry?                @relation("LeadToEnquiry")

}

model LeadFollowup {
