// ==============================================================================
// CANONICAL UNIFIED ENTERPRISE PRISMA SCHEMA: SuperAdminApp ERP + CRM
// Generated with single database, UUIDv4-compatible primary keys, and cross-domain integrity
// ==============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EnquiryStatus {
  NEW
  FOLLOW_UP
  IN_PROGRESS
  CLOSED
}

enum AllocationStatus {
  PENDING
  ALLOCATED
  ON_HOLD
  COMPLETED
}

enum AllocationType {
  HOME_CARE
  CLINICAL
  IN_HOUSE
  OTHERS
}

enum TransactionType {
  INVOICE
  RECEIPT
  EXPENSE
  REFUND
}

enum TransactionStatus {
  CREATED
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  APPROVED
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  RESOLVED
  CLOSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationStatus {
  OPEN
  WAITING
  PENDING
  RESOLVED
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MedicalAssignmentStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  WAITING_APPROVAL
  APPROVED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
  COMPLETED
}

enum ClosureStatus {
  IN_PROGRESS
  READY
  EXECUTED
}

enum OutingRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum CompanionType {
  STAFF
  VISITOR
  EXTERNAL
}

enum ResidentMovementStatus {
  OUTSIDE
  RETURNED
}

enum StaffDailyMovementStatus {
  INSIDE
  COMPLETED
}

enum StaffGateTripStatus {
  OUTSIDE
  RETURNED
}

enum VehicleMovementStatus {
  INSIDE
  COMPLETED
}

enum AmbulanceVehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
}

enum AmbulanceTripStatus {
  REQUESTED
  DISPATCH_READY
  DISPATCHED
  EN_ROUTE
  ARRIVED
  COMPLETED
  BILLED
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  AGENT
  SALES_AGENT
  EMERGENCY_TEAM
}

enum AgentStatus {
  AVAILABLE
  BUSY
  BREAK
  WRAP_UP
  OFFLINE
}

enum ChannelType {
  WHATSAPP
  VOICE
  EMAIL
  SMS
  CHAT
  INSTAGRAM
  MESSENGER
}

enum Priority {
  LOW
  NORMAL
  MEDIUM
  HIGH
  EMERGENCY
}

enum CallStatus {
  RINGING
  IN_PROGRESS
  ENDED
  MISSED
  REJECTED
  CONNECTED
  UNANSWERED
  BUSY
  FAILED
  CANCELLED
  TRANSFERRED
}

enum CallTransferStatus {
  NOT_STARTED
  INITIATED
  CONSULTING
  COMPLETED
  FAILED
  CANCELLED
}

enum CallTransferMode {
  BLIND
  ATTENDED
}

enum DuplicateMatchOutcome {
  NO_DUPLICATE
  POSSIBLE_DUPLICATE
  HIGH_CONFIDENCE
  CONFIRMED_DUPLICATE
  MERGED
  REJECTED
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  POSITIVE
  NEGATIVE
  FOLLOWUP_REQUIRED
  CONVERTED
  CLOSED
}

enum LeadPriority {
  LOW
  NORMAL
  MEDIUM
  HIGH
  EMERGENCY
}

enum EnquiryCategory {
  SERVICE_ENQUIRY
  JOB_ENQUIRY
  VOLUNTEER_ENQUIRY
  DONOR_ENQUIRY
  GENERAL_ENQUIRY
  COMPLAINT_OR_SUPPORT
}

enum MeetingType {
  CALLBACK
  APPOINTMENT
  CONSULTATION
  HOME_VISIT
  DEMO_MEETING
}

enum AppointmentStatus {
  REQUESTED
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum BookingSource {
  VOICE_AGENT
  HUMAN_AGENT
  AI_AGENT
  WHATSAPP
  INSTAGRAM
  WEBSITE
  WALK_IN
  PHONE
  REFERRAL
  CRM
  OTHER
}

enum SopDepartment {
  HR
  CCR
  SALES
  DATA_ENTRY
  GENERAL
}

enum SopPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SopExecutionStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETED
  BLOCKED
  OVERDUE
  CANCELLED
}

enum SopTemplateStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum SopRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  SHIFT_START
  SHIFT_END
  EVENT_TRIGGERED
}

enum SopApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tenant {
  id                    String                  @id @default(uuid())
  name                  String
  code                  String                  @unique
  plan                  String                  @default("ENTERPRISE")
  timezone              String                  @default("UTC")
  isActive              Boolean                 @default(true)
  isDeleted             Boolean                 @default(false)
  deletedAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  roles                 Role[]
  units                 Unit[]
  users                 User[]
  FundingCategory       FundingCategory[]
  ProjectClassification ProjectClassification[]
  Project               Project[]
  FundingAllocation     FundingAllocation[]
  ProjectExpenditure    ProjectExpenditure[]
  ambulanceVehicles     AmbulanceVehicle[]
  ambulanceTrips        AmbulanceTrip[]

  @@index([isActive])
  // CRM domain integrations
  crmAgents             Agent[]
  crmLeads              Lead[]
  crmCallSessions       CallSession[]
  sopTemplates          SopTemplate[]
  sopExecutions         SopExecution[]
  sopDocuments          SopDocument[]
  crmCustomers          Customer[]
  integrationConfigs    IntegrationConfiguration[]
  unitMemberships       UnitMembership[]

}

model Unit {
  id                String             @id @default(uuid())
  name              String
  code              String             @unique
  logoUrl           String?
  shortName         String?
  unitType          String?
  locationId        String
  address           String?
  pincode           String?
  email             String?
  phone             String?
  timezone          String?
  status            Boolean            @default(true)
  tenantId          String?
  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  location          Location           @relation(fields: [locationId], references: [id])
  tenant            Tenant?            @relation(fields: [tenantId], references: [id])
  users             User[]
  ambulanceVehicles AmbulanceVehicle[]
  ambulanceTrips    AmbulanceTrip[]

  @@index([tenantId])
  @@index([locationId])
  // CRM BusinessUnit compatibility fields
  isolationMode         String?           @default("SHARED")
  enabledProducts       String[]          @default(["CRM", "ERP"])
  enabledModules        String[]          @default(["TELEPHONY", "OMNICHANNEL", "LEADS", "APPOINTMENTS", "ANALYTICS"])
  
  // CRM Relations
  crmLeads              Lead[]
  unitMemberships       UnitMembership[]
  integrationConfigs    IntegrationConfiguration[]
  transfersFrom         LeadTransferAudit[] @relation("TransferSourceUnit")
  transfersTo           LeadTransferAudit[] @relation("TransferDestUnit")
  aiUsageRecords        AiUsageRecord[]
  sopTemplates          SopTemplate[]
  sopExecutions         SopExecution[]
  sopDocuments          SopDocument[]
  callSessions          CallSession[]

}

model Role {
  id          String           @id @default(uuid())
  name        String
  description String?
  tenantId    String
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(uuid())
  module      String
  action      String
  description String?
  isDeleted   Boolean          @default(false)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  tenantId     String
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@index([tenantId])
}

model User {
  id                           String                  @id @default(uuid())
  email                        String?                 @unique
  passwordHash                 String?
  mustChangePassword           Boolean                 @default(false)
  tokenVersion                 Int                     @default(0)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  deletedAt                    DateTime?
  firstName                    String?
  isActive                     Boolean                 @default(true)
  isDeleted                    Boolean                 @default(false)
  lastName                     String?
  mobile                       String?
  roleId                       String?
  tenantId                     String?
  unitId                       String?
  approvedItems                Approval[]              @relation("ApprovalApprover")
  auditLogs                    AuditLog[]
  staff                        Staff?
  tasksToApprove               Task[]                  @relation("TaskApprovalAuthority")
  tasksAssigned                Task[]                  @relation("TaskAssignee")
  role                         Role?                   @relation(fields: [roleId], references: [id])
  tenant                       Tenant?                 @relation(fields: [tenantId], references: [id])
  unit                         Unit?                   @relation(fields: [unitId], references: [id])
  passwordResetTokens          PasswordResetToken[]
  notifications                Notification[]
  ServiceContract              ServiceContract[]
  medicalApprovals             ServiceClosure[]        @relation("MedicalClosureApprover")
  financeApprovals             ServiceClosure[]        @relation("FinanceClosureApprover")
  assetApprovals               ServiceClosure[]        @relation("AssetClosureApprover")
  approvedVisitorPasses        VisitorPass[]           @relation("VisitorPassApprover")
  outingRequests               ResidentOutingRequest[] @relation("OutingRequester")
  outingExitsRecorded          ResidentGateMovement[]  @relation("OutingExitRecorder")
  outingReturnsRecorded        ResidentGateMovement[]  @relation("OutingReturnRecorder")
  staffDailyEntriesRecorded    StaffDailyMovement[]    @relation("StaffDailyEntryRecorder")
  staffDailyFinalExitsRecorded StaffDailyMovement[]    @relation("StaffDailyExitRecorder")
  staffTripExitsRecorded       StaffGateTrip[]         @relation("StaffTripExitRecorder")
  staffTripReturnsRecorded     StaffGateTrip[]         @relation("StaffTripReturnRecorder")
  vehicleEntriesRecorded       VehicleMovement[]       @relation("VehicleEntryRecorder")
  vehicleExitsRecorded         VehicleMovement[]       @relation("VehicleExitRecorder")

  @@index([tenantId])
  @@index([unitId])
  @@index([isActive])
  // CRM User extensions
  authUserId            String?                 @unique
  crmRole               UserRole?               @default(AGENT)
  agentProfile          Agent?
  callsMade             CallSession[]           @relation("CallsMade")
  callsReceived         CallSession[]           @relation("CallsReceived")
  supervisorLogs        SupervisorLog[]
  uploadedLeads         Lead[]                  @relation("UploadedLeads")
  leadUploads           LeadUploadHistory[]     @relation("LeadUploads")
  unitMemberships       UnitMembership[]
  leadTransfers         LeadTransferAudit[]
  sopExecutionsCreated  SopExecution[]          @relation("SopCreatedBy")
  sopExecutionsApproved SopExecution[]          @relation("SopApprovedBy")
  sopApprovals          SopApproval[]
  sopAcknowledgements   SopAcknowledgement[]
  leadDuplicateReviews  LeadDuplicateReview[]   @relation("DuplicateReviews")
  leadMerges            LeadMergeAudit[]        @relation("LeadMerges")

}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Staff {
  id                      String                  @id @default(uuid())
  empId                   String                  @unique
  firstName               String
  lastName                String?
  designation             String?
  department              String?
  phone                   String?
  email                   String?
  joiningDate             DateTime?
  status                  String                  @default("Working")
  photoUrl                String?
  userId                  String?                 @unique
  metadata                Json?
  skills                  String[]                @default([])
  location                String?
  isAvailable             Boolean                 @default(true)
  performanceScore        Float                   @default(50)
  workload                Int                     @default(0)
  currentWorkload         Int                     @default(0)
  latitude                Float?
  longitude               Float?
  shiftStart              String?
  shiftEnd                String?
  capacity                Int                     @default(5)
  stressLevel             Float                   @default(0)
  lastActiveAt            DateTime?
  tenantId                String
  unitId                  String
  isDeleted               Boolean                 @default(false)
  deletedAt               DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  allocations             Allocation[]
  MedicalAssignment       MedicalAssignment[]
  user                    User?                   @relation(fields: [userId], references: [id])
  outingCompanions        ResidentOutingRequest[]
  assignedTasks           Task[]
  documents               StaffDocument[]
  attendanceLogs          AttendanceLog[]
  leaveRequests           LeaveRequest[]
  incidentLogs            StaffIncidentLog[]
  payrollRecords          PayrollRecord[]
  salary                  StaffSalary?
  dailyMovements          StaffDailyMovement[]
  tripCompanions          StaffGateTrip[]         @relation("StaffTripCompanion")
  ambulanceTripsAsDriver  AmbulanceTrip[]         @relation("AmbulanceTripDriver")
  ambulanceTripsAsSupport AmbulanceTrip[]         @relation("AmbulanceTripSupportStaff")

  @@index([tenantId])
  @@index([unitId])
}

model StaffDocument {
  id           String   @id @default(uuid())
  staffId      String
  tenantId     String
  unitId       String
  documentType String
  fileName     String
  fileUrl      String
  filePath     String
  status       String
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([tenantId])
  @@index([unitId])
}

model StaffSalary {
  id             String   @id @default(uuid())
  staffId        String   @unique
  tenantId       String
  unitId         String
  monthlySalary  Float
  fixedAllowance Float
  fixedDeduction Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([tenantId, unitId])
}

model AttendanceLog {
  id        String    @id @default(uuid())
  staffId   String
  date      DateTime  @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  method    String    @default("Manual")
  status    String    @default("Present")
  metadata  Json?
  tenantId  String
  unitId    String
  staff     Staff     @relation(fields: [staffId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([tenantId, unitId, date])
  @@index([status, date])
}

model LeaveRequest {
  id          String   @id @default(uuid())
  staffId     String
  leaveType   String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      String   @default("PENDING")
  requestedBy String?
  approvedBy  String?
  remarks     String?
  tenantId    String
  unitId      String
  staff       Staff    @relation(fields: [staffId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PayrollRecord {
  id                String    @id @default(uuid())
  staffId           String
  tenantId          String
  unitId            String
  month             String
  workingDays       Int
  presentDays       Int
  approvedLeaveDays Int
  absentDays        Int
  baseSalary        Float
  fixedAllowance    Float
  fixedDeduction    Float
  grossPay          Float
  deductions        Float
  netPay            Float
  status            String
  processedAt       DateTime?
  processedBy       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, month])
  @@index([tenantId, unitId, month])
  @@index([staffId, month])
}

model StaffIncidentLog {
  id          String   @id @default(uuid())
  staffId     String
  category    String
  description String
  date        DateTime @default(now())
  reportedBy  String?
  actionTaken String?
  tenantId    String
  unitId      String
  staff       Staff    @relation(fields: [staffId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model City {
  id        String    @id @default(uuid())
  name      String
  state     String
  country   String
  status    Boolean   @default(true)
  tenantId  String
  unitId    String
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, state, country, tenantId, unitId])
  @@index([tenantId])
  @@index([unitId])
}

model Location {
  id        String   @id @default(uuid())
  name      String
  state     String
  country   String
  pincode   String?
  createdAt DateTime @default(now())
  units     Unit[]

  @@unique([name, state, country, pincode])
  @@index([name])
  @@index([state])
  @@index([country])
}

model Client {
  id              String            @id @default(uuid())
  refNo           String            @unique
  name            String
  mobile          String
  email           String?
  address         String?
  tenantId        String
  unitId          String
  isDeleted       Boolean           @default(false)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ChannelIdentity ChannelIdentity[]
  conversations   Conversation[]
  enquiries       Enquiry[]

  @@index([tenantId])
  @@index([unitId])
  @@index([mobile])
  // CRM Customer & Lead linkages
  crmCustomerId         String?                 @unique
  crmCustomer           Customer?               @relation("ClientCustomer", fields: [crmCustomerId], references: [id])
  crmLeads              Lead[]

}

model JobApplication {
  id             String    @id @default(uuid())
  applicationNo  String    @unique
  companyUnit    String
  applyFor       String
  experience     String?
  location       String?
  applicantName  String
  mobileNo       String
  email          String?
  resumeUrl      String?
  details        Json?
  termsAcceptedAt DateTime?
  termsVersion   String?
  followupStatus String    @default("Pending")
  interestStatus String    @default("Neutral")
  tenantId       String
  unitId         String
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId])
  @@index([unitId])
}

model Enquiry {
  id                  String              @id @default(uuid())
  refNo               String              @unique
  clientId            String
  serviceId           String?
  mode                String?
  source              String?
  channelId           String?
  rawMessage          String?
  description         String?
  status              EnquiryStatus       @default(NEW)
  priority            String?
  intent              String?
  sentiment           String?
  summary             String?
  urgency             String?
  isConverted         Boolean?            @default(false)
  convertedAt         DateTime?
  serviceRequirements Json?
  tenantId            String
  unitId              String
  isDeleted           Boolean             @default(false)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  admission           Admission?
  allocation          Allocation?
  automationScores    AutomationScore[]
  conversations       Conversation[]
  client              Client              @relation(fields: [clientId], references: [id])
  service             ClientService?      @relation(fields: [serviceId], references: [id])
  followUps           FollowUp[]
  MedicalAssignment   MedicalAssignment[]
  tasks               Task[]
  Referral            Referral?

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([createdAt])
  // CRM Lead cross-reference
  crmLeadId             String?                 @unique
  crmLead               Lead?                   @relation("LeadToEnquiry", fields: [crmLeadId], references: [id])

}

model Admission {
  id                String              @id @default(uuid())
  enquiryId         String?             @unique
  patientId         String
  tenantId          String
  unitId            String
  status            String              @default("ACTIVE")
  admissionPriority String?
  healthCondition   String?
  clinicalStatus    String?
  floor             String?
  room              String?
  bed               String?
  admittedAt        DateTime            @default(now())
  dischargedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  enquiry           Enquiry?            @relation(fields: [enquiryId], references: [id])
  patient           Patient             @relation(fields: [patientId], references: [id])
  MedicalAssignment MedicalAssignment[]
  serviceContract   ServiceContract?
  serviceClosure    ServiceClosure?
  allocation        Allocation?
  consents          ResidentConsent[]

  @@index([tenantId])
  @@index([unitId])
  @@index([patientId])
}

model FollowUp {
  id                 String    @id @default(uuid())
  enquiryId          String
  notes              String?
  scheduledAt        DateTime?
  actualAt           DateTime?
  channel            String?   @default("CALL")
  category           String?
  priority           String?   @default("NORMAL")
  response           Boolean   @default(false)
  converted          Boolean   @default(false)
  responseAt         DateTime?
  outcome            String?   @default("PENDING")
  variant            String?
  successScore       Float     @default(0)
  clientInterest     String?
  readyToPayAmount   Float?
  paymentMode        String?
  nextFollowupStatus String?
  assignedStaffId    String?
  tenantId           String
  unitId             String
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  enquiry            Enquiry   @relation(fields: [enquiryId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([scheduledAt])
}

model Allocation {
  id                String               @id @default(uuid())
  refNo             String               @unique
  enquiryId         String?              @unique
  admissionId       String?              @unique
  type              AllocationType       @default(HOME_CARE)
  staffId           String?
  startDate         DateTime?
  endDate           DateTime?
  status            AllocationStatus     @default(PENDING)
  metadata          Json?
  allocationScore   Float?               @default(0)
  tenantId          String
  unitId            String
  isDeleted         Boolean              @default(false)
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  accounts          AccountTransaction[]
  enquiry           Enquiry?             @relation(fields: [enquiryId], references: [id])
  admission         Admission?           @relation(fields: [admissionId], references: [id])
  staff             Staff?               @relation(fields: [staffId], references: [id])
  MedicalAssignment MedicalAssignment[]

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

model AccountTransaction {
  id                 String            @id @default(uuid())
  refNo              String            @unique
  allocationId       String?
  type               TransactionType
  amount             Float
  paymentMode        String?
  category           String?
  clientName         String?
  status             TransactionStatus @default(CREATED)
  notes              String?
  discountAmount     Float?            @default(0)
  discountApprovedBy String?
  metadata           Json?
  date               DateTime          @default(now())
  tenantId           String
  unitId             String
  isDeleted          Boolean           @default(false)
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  allocation         Allocation?       @relation(fields: [allocationId], references: [id])

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
  @@index([type])
}

model Task {
  id                  String              @id @default(uuid())
  refNo               String              @unique
  title               String
  description         String?
  priority            String              @default("MEDIUM")
  aiSummary           String?
  aiUrgency           String?
  enquiryId           String?
  assigneeId          String?
  assignedStaffId     String?
